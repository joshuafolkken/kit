{
	"permissions": {
		"allow": ["Bash(*)"],
		"deny": [
			"Bash(rm -rf *)",
			"Bash(rm -rf /*)",
			"Bash(rm -fr *)",
			"Bash(gh repo delete*)",
			"Bash(gh repo archive*)",
			"Bash(gh pr close*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(!.env.example)",
			"Read(!.env.test)",
			"Read(./.dev.vars)",
			"Read(~/.config/gh/**)",
			"Read(~/.codex/auth.json)",
			"Read(~/.netrc)",
			"Read(~/.ssh/**)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push *--force*)",
			"Bash(git push * -f)",
			"Bash(git push * -f *)",
			"Bash(git push * +*)",
			"Bash(git push *--delete*)",
			"Bash(git push -d*)",
			"Bash(git push * -d)",
			"Bash(git push * -d *)",
			"Bash(git branch -d*)",
			"Bash(git branch -D*)",
			"Bash(git branch --delete*)",
			"Bash(gh api *DELETE*git/refs/heads/*)",
			"Bash(gh api *git/refs/heads/*DELETE*)",
			"Bash(git add*)",
			"Bash(git stage*)",
			"Bash(git rm*)",
			"Bash(git mv*)",
			"Bash(git reset*)",
			"Bash(git restore --staged*)",
			"Bash(git restore -S*)",
			"Bash(git commit*)",
			"Bash(gh pr merge*)",
			"Bash(gh api *pulls/*/merge*)",
			"Bash(gh api graphql*mergePullRequest*)",
			"Bash(sudo *)",
			"Bash(curl *)",
			"Bash(wget *)",
			"Bash(nc *)",
			"Bash(gh auth token*)",
			"Bash(printenv)"
		]
	},
	"env": {
		"BASH_MAX_OUTPUT_LENGTH": "8000"
	},
	"enableArtifact": false,
	"statusLine": {
		"type": "command",
		"command": "pnpm josh usage:tee"
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-hook.sh\" audit-provision --session-start",
						"timeout": 90
					}
				]
			},
			{
				"matcher": "clear",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-hook.sh\" audit-provision --session-model",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-hook.sh\" session-lang",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|Read|Write|AskUserQuestion|Agent|Task|Glob|Grep|WebFetch",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-hook.sh\" pretool-guard",
						"timeout": 20
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-hook.sh\" format-edited",
						"timeout": 90
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-hook.sh\" stop-guard",
						"timeout": 20
					}
				]
			}
		]
	}
}
