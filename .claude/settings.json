{
	"permissions": {
		"defaultMode": "bypassPermissions",
		"allow": ["Bash(*)"],
		"deny": [
			"Bash(rm -rf *)",
			"Bash(rm -rf /*)",
			"Bash(rm -fr *)",
			"Bash(gh repo delete*)",
			"Bash(gh repo archive*)",
			"Bash(gh pr close*)",
			"Read(./.env)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push *--force*)",
			"Bash(git push * -f)",
			"Bash(git push * -f *)",
			"Bash(git push * +*)",
			"Bash(git push *--delete*)",
			"Bash(git push -d*)",
			"Bash(git push * -d)",
			"Bash(git push * -d *)",
			"Bash(git branch -d*)",
			"Bash(git branch -D*)",
			"Bash(git branch --delete*)",
			"Bash(gh api *DELETE*git/refs/heads/*)",
			"Bash(gh api *git/refs/heads/*DELETE*)",
			"Bash(git add*)",
			"Bash(git stage*)",
			"Bash(git rm*)",
			"Bash(git mv*)",
			"Bash(git reset*)",
			"Bash(git restore --staged*)",
			"Bash(git restore -S*)",
			"Bash(git commit*)",
			"Bash(gh pr merge*)",
			"Bash(gh api *pulls/*/merge*)",
			"Bash(gh api graphql*mergePullRequest*)",
			"Bash(sudo *)"
		]
	},
	"env": {
		"BASH_MAX_OUTPUT_LENGTH": "8000"
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "pnpm josh audit:provision",
						"timeout": 180
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "echo 'MANDATORY before writing any implementation code: present the two-layer work summary (Now / Change / Check, then every change with its test). Full rule: Code Change Rules Step 0 in CLAUDE.md.'"
					},
					{
						"type": "command",
						"command": "if [ -f dist/hooks/session-lang.js ]; then node dist/hooks/session-lang.js; else pnpm josh session:lang; fi",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|Read|Write|AskUserQuestion",
				"hooks": [
					{
						"type": "command",
						"command": "if [ -f dist/hooks/pretool-guard.js ]; then node dist/hooks/pretool-guard.js; else pnpm josh pretool:guard; fi",
						"timeout": 20
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "if [ -f dist/hooks/format-edited.js ]; then node dist/hooks/format-edited.js; else pnpm josh format:edited; fi",
						"timeout": 90
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "if [ -f dist/hooks/stop-guard.js ]; then node dist/hooks/stop-guard.js; else pnpm josh stop:guard; fi",
						"timeout": 20
					}
				]
			}
		]
	}
}
