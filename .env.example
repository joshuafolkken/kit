# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# See docs/scripts-ai.md for how to obtain the Telegram values.

# Required for Telegram notifications (scripts-ai / josh notify).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, personal. Language for session-facing dialogue and AskUserQuestion
# options, and for artifact prose — Issue bodies, Issue / PR comments, Telegram
# notification bodies (e.g. `ja`, `en`). When unset, dialogue matches the
# conversation language and artifact prose defaults to `ja`. Issue / PR titles,
# code comments, test titles and commit messages always stay English.
JOSH_SESSION_LANG=

# Optional, personal. Integer offset applied to this project's dev and preview
# ports together (`PORT_SEED=1` → dev 5174, preview 4174), so several kit
# projects on one machine can run their servers at the same time. Left blank —
# as it is here — or unset means `0`, the historical 5173 / 4173, so CI and
# un-migrated projects are unaffected. An invalid value is a hard error, never a
# silent fall back. `josh port` and Playwright both read it from this file.
# See docs/josh-commands.md for `josh port`.
PORT_SEED=

# Optional, personal. Where `josh lane:open` puts a lane's work tree. Left blank
# — as it is here — or unset means `.<repository-name>-lanes`, a hidden sibling
# of the repository root, which keeps a second full checkout out of every path
# the lint run, the unit suite and the spell check walk.
# See docs/josh-commands.md for `josh lane:open`.
JOSH_LANE_ROOT=

# Optional, personal. The seed lanes are numbered from: a lane takes the lowest
# free seat in base+1..base+9, and this checkout itself keeps the base, so the
# main work tree never moves off the ports it has today. Left blank — as it is
# here — or unset means this project's own `PORT_SEED`. Set it, to a free
# multiple of ten no higher than 990, only when the nine seeds just above this
# project's are already taken by another project. Every seed has to stay under
# 1000: dev is 5173+seed and preview is 4173+seed, so two seeds 1000 apart put
# one project's preview on another project's dev port.
# See docs/josh-commands.md for `josh lane:open`.
JOSH_LANE_SEED_BASE=

# Optional, personal. Turns the rule-compliance measurement back on. `josh eval`
# is five real Claude sessions per run, so the gate that asks for it — `josh
# eval:scope`, inside every workflow command's verification step — is opt-in:
# left blank, as it is here, or unset, it answers `skip` and nothing is
# measured. `on` (also `1`, `true`, `yes`) restores the decision from the
# changed paths. `josh eval` typed by a person runs either way.
# See docs/eval.md for what it measures and why it ships off.
JOSH_EVAL=

# Optional, personal. Overrides for the repository map `josh doctor` prints and
# other commands resolve local paths from. Entries are `owner/repo=/absolute/path`,
# comma-separated. Discovery is automatic — the parent directory of the current
# repository, one level deep — so this is only for the exceptions: a repository
# that is not a sibling, or one checked out twice. The owner restriction is not
# overridable: an entry naming a different owner is dropped.
# See docs/josh-commands.md for `josh doctor`.
JOSH_REPO_PATHS=
