# Copy this file to `.env` and fill in the values you need. `.env` is gitignored.
# Every key kit reads from `.env` is listed below. Each key's first comment line
# gives its default and, where they can be listed, its accepted values; both
# come from docs/environment-variables.md, which also lists the variables
# that only take effect when set in the shell. A blank value (`KEY=`) is the
# same as leaving the key out, so a key you leave blank follows kit's default
# even when that default changes.

# --- Notifications and language: docs/environment-variables.md → "Notifications and language" ---

# Default: — (required unless JOSH_NOTIFY=off)
# Telegram bot token every notification is sent with.
# docs/how-to/set-up-notifications.md shows how to obtain it.
TELEGRAM_BOT_TOKEN=

# Default: — (required unless JOSH_NOTIFY=off)
# The chat that receives the notifications.
# docs/how-to/set-up-notifications.md shows how to obtain it.
TELEGRAM_CHAT_ID=

# Default: on · Values: off
# `off` skips every notification and makes the two values above unnecessary.
JOSH_NOTIFY=

# Default: — (neither) · Values: planning, completion
# Optional notification types to send, comma-separated.
JOSH_NOTIFY_OPT_IN=

# Default: ja (josh init seeds it from the OS locale) · Values: ja, en
# Language of session dialogue and artifact prose.
JOSH_SESSION_LANG=

# --- Ports and lanes: docs/environment-variables.md → "Ports and lanes" ---

# Default: 0 (dev 5173, preview 4173) · Values: 0–99
# Moves this project's dev and preview ports by `seed × 10`.
PORT_SEED=

# Default: .<repository-name>-lanes, beside the repository
# Where `josh lane:open` puts a lane's work tree.
JOSH_LANE_ROOT=

# Default: 8
# How many lanes one repository runs at once.
JOSH_LANE_LIMIT=

# Default: Google Chrome.app,Visual Studio Code.app
# Apps whose summed resident size a `load` sample records, comma-separated.
JOSH_LANE_RESIDENT_APPS=

# Default: off · Values: 1, true, yes, on
# Lets the E2E run reuse this project's own server already on the port.
PLAYWRIGHT_REUSE_SERVER=

# --- Unattended agents: docs/environment-variables.md → "Unattended agents" ---
# A model default depends on the provider: that docs section names each one.

# Default: anthropic · Values: anthropic, openai
# The default provider for a new `josh backlogrun`.
JOSH_AGENT_PROVIDER=

# Default: claude-opus-5-5 with Claude Code; the provider decides otherwise
# Model of the run that schedules the batch.
JOSH_SCHEDULER_MODEL=

# Default: medium · Values: low, medium, high, xhigh, max
# Effort of the run that schedules the batch.
JOSH_SCHEDULER_EFFORT=

# Default: claude-opus-5-5 with Claude Code; the provider decides otherwise
# Model of each lane that implements an Issue, outside the ship phase.
JOSH_WORKER_MODEL=

# Default: medium, and low once the lane reaches the gate · Values: low, medium, high, xhigh, max
# Effort of each lane that implements an Issue.
JOSH_WORKER_EFFORT=

# Default: claude-sonnet-5-5 with Claude Code; the provider decides otherwise
# Model a lane relaunches on once it reaches the gate.
JOSH_WORKER_SHIP_MODEL=

# Default: claude-opus-5-5 with Claude Code; the provider decides otherwise
# Model of the review a lane's change gets.
JOSH_REVIEWER_MODEL=

# Default: medium · Values: low, medium, high, xhigh, max
# Effort of the review a lane's change gets.
JOSH_REVIEWER_EFFORT=

# Default: claude-sonnet-5-5 with Claude Code; the provider decides otherwise
# Model of the round 2 and later verification pass; falls back to JOSH_REVIEWER_MODEL.
JOSH_REVIEWER_VERIFICATION_MODEL=

# Default: high · Values: low, medium, high, xhigh, max
# Effort of the round 2 and later verification pass; falls back to JOSH_REVIEWER_EFFORT.
JOSH_REVIEWER_VERIFICATION_EFFORT=

# Default: off · Values: 1
# `1` pairs a round 1 review with a Sonnet reviewer.
JOSH_REVIEWER_PAIRED=

# Default: claude-sonnet-5-5 with Claude Code; the provider decides otherwise
# Model the consultation main line hands broad investigation to.
JOSH_INVESTIGATION_MODEL=

# --- Runs: docs/environment-variables.md → "Runs" ---

# Default: josh.progress_interval_minutes in package.json, else 20
# Minutes a run is quiet before a progress line. In `.env` it reaches only the
# `josh pretool:guard` heartbeat, not `josh run:progress`: set it in the shell,
# or commit `josh.progress_interval_minutes` in package.json, to reach both.
JOSH_PROGRESS_INTERVAL_MINUTES=

# Default: josh.review_gate in package.json, else local · Values: ci, local
# Shared review location setting; review execution does not consume it yet.
JOSH_REVIEW_GATE=

# Default: DEFAULT_WIP_CAP in scripts/issue/issue-wip.ts · Values: off
# Open-Issue cap `josh issue:file` holds a filing past: a positive integer
# replaces the default, `off` turns the cap off.
JOSH_WIP_CAP=

# Default: off · Values: on, 1, true, yes
# Runs the end-of-run retrospective when a backlog drains.
JOSH_RETROSPECTIVE=

# Default: off · Values: on, 1, true, yes
# Lets `josh run:merge` launch the overrun and baseline investigations of merged lanes.
JOSH_LANE_INVESTIGATION=

# Default: sibling repositories are found automatically
# Repository map overrides: `owner/repo=/absolute/path`, comma-separated.
JOSH_REPO_PATHS=

# Default: off
# Any non-blank value writes errors a state check swallowed to stderr.
JOSH_DEBUG=

# Default: auto · Values: auto, rest, graphql
# Which transport GitHub reads take.
JOSH_GH_TRANSPORT=

# Default: /tmp (os.tmpdir() on Windows or when /tmp is not writable)
# The directory every host-wide record goes to.
JOSH_TEMP_ROOT=

# --- Merge, release and dependency updates: docs/environment-variables.md → "Merge, release and dependency updates" ---

# Default: 32 minutes
# Seconds `josh followup` waits for CI.
JOSH_CI_TIMEOUT_SECONDS=

# Default: SonarQube
# The checks a merge waits for, comma-separated.
JOSH_REQUIRED_CHECKS=

# Default: 12
# How old the last dependency update may be before `josh latest:scope` answers `required`.
JOSH_LATEST_MAX_AGE_HOURS=

# Default: chromium
# Browsers `josh latest:update` installs after it moves @playwright/test, space-separated.
JOSH_PLAYWRIGHT_BROWSERS=

# --- Hook payload capture: docs/environment-variables.md → "Hook payload capture" ---

# Default: off
# A directory the hooks save each raw stdin payload to.
JOSH_HOOK_CAPTURE_DIR=
