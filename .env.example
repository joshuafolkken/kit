# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Every variable below — whether it is required, its default and when it is
# used — is described in docs/environment-variables.md, along with the ones
# not listed here. A blank value (`KEY=`) is the same as leaving the key out.

# Required for Telegram notifications, unless JOSH_NOTIFY=off.
# docs/scripts-ai.md shows how to obtain both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. `off` skips every notification and makes the two values above
# unnecessary.
JOSH_NOTIFY=

# Optional, personal. Language of session dialogue and artifact prose (`ja`, `en`).
JOSH_SESSION_LANG=

# Optional, personal. 0–99; moves this project's dev and preview ports.
PORT_SEED=

# Optional, personal. Where `josh lane:open` puts a lane's work tree.
JOSH_LANE_ROOT=

# Optional. Model and effort per role for unattended backlogrun agents.
JOSH_SCHEDULER_MODEL=
JOSH_SCHEDULER_EFFORT=
JOSH_WORKER_MODEL=
JOSH_WORKER_EFFORT=
JOSH_REVIEWER_MODEL=
JOSH_REVIEWER_EFFORT=

# Optional, personal. Minutes a run is quiet before a progress line.
JOSH_PROGRESS_INTERVAL_MINUTES=

# Optional, personal. Repository map overrides: `owner/repo=/absolute/path`, comma-separated.
JOSH_REPO_PATHS=
