{
	"version": "1.863.0",
	"name": "@joshuafolkken/kit",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
	"engines": {
		"node": ">=22.19.0"
	},
	"josh": {
		"progress_interval_minutes": 15
	},
	"bin": {
		"josh": "dist/josh.js"
	},
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain@1.5.1 setup-ci",
		"prepare": "(command -v lefthook >/dev/null 2>&1 && { lefthook install || echo 'lefthook install failed: git hooks are NOT installed. A set core.hooksPath is the usual cause. See https://github.com/joshuafolkken/kit/blob/main/docs/init.md#corehookspath-stops-lefthook-installing-anything' >&2; } || true)",
		"build": "tsx scripts/build/build-bin.ts && tsx scripts/build/build-hooks.ts && tsx scripts/build/build-version.ts && tsx scripts/build/build-config-merge.ts && tsx scripts/build/build-managed-marker.ts && tsx scripts/build/build-self-sync-guard.ts && tsx scripts/build/build-claude-md.ts",
		"prepack": "tsx scripts/version/publishable-range-check.ts && tsx scripts/build/build-bin.ts && tsx scripts/build/build-hooks.ts && tsx scripts/build/build-version.ts && tsx scripts/build/build-config-merge.ts && tsx scripts/build/build-managed-marker.ts && tsx scripts/build/build-self-sync-guard.ts && tsx scripts/build/build-claude-md.ts",
		"josh": "tsx scripts/josh/josh.ts"
	},
	"files": [
		"dist",
		"scripts",
		"scripts-ai",
		"prompts",
		"evals",
		"templates",
		"env",
		"eslint",
		"ports",
		"prettier",
		"tsconfig",
		"cspell",
		"lefthook",
		".claude/settings.json",
		".claude/skills",
		".claude/.claude-plugin",
		".claude-plugin",
		".codex",
		".vscode",
		".github",
		"CLAUDE.md",
		"AGENTS.md",
		"GEMINI.md",
		"CODE_OF_CONDUCT.md",
		"SECURITY.md",
		".cursorrules",
		".coderabbit.yaml",
		".gitattributes",
		".mcp.json",
		".ncurc.json",
		".prettierignore",
		"pnpm-workspace.yaml",
		"tsconfig.sonar.json",
		"playwright.config.ts",
		"!**/*.test.ts",
		"!scripts/gh/gh-subcommand-guard.ts",
		"!**/*.spec.ts",
		"!**/*-fixture.ts",
		"!scripts/eval",
		"!scripts/time",
		"!scripts/cost"
	],
	"imports": {
		"#eslint/*": "./eslint/*",
		"#scripts/*": "./scripts/*.ts",
		"#playwright-config": "./playwright.config.ts",
		"#ports": "./ports/index.js",
		"#ports/*": "./ports/*.ts"
	},
	"exports": {
		"./eslint/base": "./eslint/base.js",
		"./eslint/vanilla": "./eslint/vanilla.js",
		"./eslint/test-filename": "./eslint/rules/test-filename.js",
		"./env": {
			"types": "./env/index.d.ts",
			"default": "./env/index.js"
		},
		"./ports": {
			"types": "./ports/index.d.ts",
			"default": "./ports/index.js"
		},
		"./prettier": {
			"types": "./prettier/index.d.ts",
			"default": "./prettier/index.js"
		},
		"./tsconfig/base": {
			"types": "./tsconfig/base.json",
			"default": "./tsconfig/base.json"
		},
		"./cspell": "./cspell/index.yaml",
		"./version": {
			"types": "./dist/version/index.d.ts",
			"default": "./dist/version/index.js"
		},
		"./config-merge": {
			"types": "./dist/config-merge/index.d.ts",
			"default": "./dist/config-merge/index.js"
		},
		"./self-sync-guard": {
			"types": "./dist/self-sync-guard/index.d.ts",
			"default": "./dist/self-sync-guard/index.js"
		},
		"./managed-marker": {
			"types": "./dist/managed-marker/index.d.ts",
			"default": "./dist/managed-marker/index.js"
		}
	},
	"peerDependencies": {
		"@playwright/test": ">=1.0.0",
		"eslint": ">=9.18.0",
		"svelte": ">=5.0.0"
	},
	"peerDependenciesMeta": {
