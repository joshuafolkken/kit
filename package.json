{
	"version": "1.1128.0",
	"name": "@joshuafolkken/kit",
	"description": "Development toolkit for AI-assisted projects: formatting, AI assistant rules and a Git/GitHub Issue workflow for any repository, plus lint, type check, tests and hooks for Node projects",
	"keywords": [
		"ai",
		"claude-code",
		"cli",
		"codex",
		"developer-tools",
		"eslint",
		"prettier",
		"toolkit",
		"workflow"
	],
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joshuafolkken/kit.git"
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
	"engines": {
		"node": ">=22.19.0"
	},
	"josh": {
		"progress_interval_minutes": 15
	},
	"bin": {
		"josh": "dist/josh.js"
	},
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain@1.5.20 setup-ci && node -e \"if(!process.env.CI&&!process.env.GLOBAL_AGENT_HTTP_PROXY)console.warn('Warning: safe-chain is not scanning this install because its shell integration is not active. Install safe-chain (https://github.com/AikidoSec/safe-chain#installation) or run: safe-chain setup - then restart your terminal.')\"",
		"prepare": "(command -v lefthook >/dev/null 2>&1 && { lefthook install || echo 'lefthook install failed: git hooks are NOT installed. A set core.hooksPath is the usual cause. See https://github.com/joshuafolkken/kit/blob/main/docs/init.md#corehookspath-stops-lefthook-installing-anything' >&2; } || true)",
		"build": "tsx scripts/build/build-bin.ts && tsx scripts/build/build-hooks.ts && tsx scripts/build/build-version.ts && tsx scripts/build/build-config-merge.ts && tsx scripts/build/build-managed-marker.ts && tsx scripts/build/build-self-sync-guard.ts && tsx scripts/build/build-claude-md.ts && tsx scripts/build/build-codex-hooks.ts",
		"prepack": "tsx scripts/version/publishable-range-check.ts && pnpm build",
		"josh": "tsx scripts/josh/josh.ts"
	},
	"files": [
		"dist",
		"scripts",
		"prompts",
		"templates",
		"env",
		"eslint",
		"ports",
		"prettier",
		"tsconfig",
		"cspell",
		"lefthook",
		".claude/settings.json",
		".claude/skills",
		".claude/.claude-plugin",
		".claude-plugin",
		".codex",
		".vscode",
		".github",
		"CLAUDE.md",
		"AGENTS.md",
		"GEMINI.md",
		"CODE_OF_CONDUCT.md",
		"SECURITY.md",
		".cursorrules",
		".coderabbit.yaml",
		".gitattributes",
		".mcp.json",
		".ncurc.json",
		".prettierignore",
		"pnpm-workspace.yaml",
		".pnpmfile.mjs",
		"tsconfig.sonar.json",
		"playwright.config.ts",
		"!**/*.test.ts",
		"!scripts/gh/gh-subcommand-guard.ts",
		"!**/*.spec.ts",
		"!**/*-fixture*.ts",
		"!**/__snapshots__",
		"!**/*.golden.txt",
		"!scripts/eval",
		"!scripts/time",
		"!scripts/cost",
		"!scripts/retrospective",
		"!scripts/dogfood",
		"!scripts/test/classify-isolation.ts",
		"!scripts/test/http-fault-injection.ts",
		"!scripts/test/josh-harness*.ts",
		"!scripts/test/pure-files.ts",
		"!scripts/test/test-network-guard.ts",
		"!scripts/test/test-repository-guard.ts",
		"!scripts/test/test-state-guard.ts",
		"!scripts/test/test-stdout-guard.ts",
		"!scripts/test/test-telegram-guard.ts",
		"!scripts/test/unit-guard-environment.ts",
		"!scripts/test/unit-projects.ts",
		"!scripts/test/vitest-include-globs.ts",
		"!scripts/build/shim-shell.ts",
		"!scripts/claude/skill-meta.ts",
		"!scripts/document/document-scan.ts",
		"!scripts/exports/member-usage.ts",
		"!scripts/exports/namespace-escape.ts",
		"!scripts/exports/namespace-members.ts",
		"!scripts/exports/unused-members.ts",
		"!scripts/document/generate-catalog.ts",
		"!scripts/document/retired-phrases.ts",
		"!scripts/document/review-agent-type.ts",
		"!scripts/document/single-source.ts",
		"!scripts/hooks/hook-bundle-ready.ts",
		"!scripts/hooks/prompt-hooks.ts",
		"!scripts/josh/josh-script-reader.ts",
		"!scripts/package/production-dependency-graph.ts",
		"!scripts/rules/delivered-rules-harness.ts",
		"!scripts/rules/top-level-scripts-guard.ts"
	],
	"imports": {
		"#eslint/*": "./eslint/*",
		"#scripts/*": "./scripts/*.ts",
		"#playwright-config": "./playwright.config.ts",
		"#ports": "./ports/index.js",
		"#ports/*": "./ports/*.ts"
	},
	"exports": {
		"./eslint/base": "./eslint/base.js",
		"./eslint/vanilla": "./eslint/vanilla.js",
		"./eslint/test-filename": "./eslint/rules/test-filename.js",
		"./env": {
			"types": "./env/index.d.ts",
			"default": "./env/index.js"
		},
		"./ports": {
			"types": "./ports/index.d.ts",
			"default": "./ports/index.js"
		},
		"./web-server": {
			"types": "./ports/web-server.d.ts",
			"default": "./ports/web-server.js"
		},
		"./prettier": {
			"types": "./prettier/index.d.ts",
			"default": "./prettier/index.js"
		},
		"./prettier/basic": {
			"types": "./prettier/basic.d.ts",
			"default": "./prettier/basic.js"
		},
		"./prettier/static": {
			"types": "./prettier/static.d.ts",
			"default": "./prettier/static.js"
		},
		"./tsconfig/base": {
			"types": "./tsconfig/base.json",
			"default": "./tsconfig/base.json"
		},
		"./cspell": "./cspell/index.yaml",
		"./version": {
			"types": "./dist/version/index.d.ts",
			"default": "./dist/version/index.js"
		},
		"./config-merge": {
			"types": "./dist/config-merge/index.d.ts",
			"default": "./dist/config-merge/index.js"
		},
		"./self-sync-guard": {
			"types": "./dist/self-sync-guard/index.d.ts",
			"default": "./dist/self-sync-guard/index.js"
		},
		"./managed-marker": {
			"types": "./dist/managed-marker/index.d.ts",
			"default": "./dist/managed-marker/index.js"
		}
	},
	"peerDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@playwright/test": ">=1.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
