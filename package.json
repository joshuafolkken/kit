{
	"version": "1.1784.0",
	"name": "@joshuafolkken/kit",
	"description": "Development toolkit for AI-assisted projects: formatting, AI assistant rules and a Git/GitHub Issue workflow for any repository, plus lint, type check, tests and hooks for Node projects",
	"keywords": [
		"ai",
		"claude-code",
		"cli",
		"codex",
		"developer-tools",
		"eslint",
		"prettier",
		"toolkit",
		"workflow"
	],
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joshuafolkken/kit.git"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"engines": {
		"node": "^22.19.0 || ^24.0.0 || >=26.0.0"
	},
	"josh": {
		"progress_interval_minutes": 15
	},
	"bin": {
		"josh": "dist/josh.js"
	},
	"scripts": {
		"preinstall": "node -e \"if(!process.env.CI&&!process.env.GLOBAL_AGENT_HTTP_PROXY)console.warn('Warning: safe-chain (@aikidosec/safe-chain) is not scanning this install because its shell integration is not active. Install it with the hash-verified steps at https://github.com/joshuafolkken/kit/blob/main/SECURITY.md#installing-safe-chain - then restart your terminal.')\"",
		"prepare": "(command -v lefthook >/dev/null 2>&1 && { lefthook install || echo 'lefthook install failed: git hooks are NOT installed. A set core.hooksPath is the usual cause. See https://github.com/joshuafolkken/kit/blob/main/docs/init.md#corehookspath-stops-lefthook-installing-anything' >&2; } || true)",
		"build": "tsx scripts/build/build.ts",
		"prepack": "tsx scripts/version/publishable-range-check.ts && pnpm build",
		"josh": "tsx scripts/josh/josh.ts"
	},
	"files": [
		"dist",
		"scripts",
		"prompts",
		"templates",
		"env",
		"eslint",
		"ports",
		"prettier",
		"tsconfig",
		"cspell",
		"lefthook",
		".claude/settings.json",
		".claude/skills",
		".claude/agents",
		".claude/.claude-plugin",
		".claude-plugin",
		".codex",
		".vscode",
		".github",
		"CLAUDE.md",
		"AGENTS.md",
		"GEMINI.md",
		"CODE_OF_CONDUCT.md",
		"SECURITY.md",
		".cursorrules",
		".coderabbit.yaml",
		".gitattributes",
		".mcp.json",
		".prettierignore",
		"pnpm-workspace.yaml",
		".pnpmfile.mjs",
		"tsconfig.sonar.json",
		"playwright.config.ts",
		"!**/*.test.ts",
		"!**/*.spec.ts",
		"!**/*-fixture*.ts",
		"!**/__snapshots__",
		"!**/*.golden.txt",
		"!dist/hooks/.inputs-verified.json*",
		"!dist/.hooks-staging-*",
		"!dist/.commands-test-*"
	],
	"imports": {
		"#eslint/*": "./eslint/*",
		"#scripts/*": "./scripts/*.ts",
		"#tools/*": "./tools/*.ts",
		"#playwright-config": "./playwright.config.ts",
		"#ports": "./ports/index.js",
		"#ports/*": "./ports/*.ts"
	},
	"exports": {
		"./eslint/base": "./eslint/base.js",
		"./eslint/vanilla": "./eslint/vanilla.js",
		"./eslint/test-filename": "./eslint/rules/test-filename.js",
		"./env": {
			"types": "./env/index.d.ts",
			"default": "./env/index.js"
		},
		"./ports": {
			"types": "./ports/index.d.ts",
			"default": "./ports/index.js"
		},
		"./web-server": {
			"types": "./ports/web-server.d.ts",
			"default": "./ports/web-server.js"
		},
		"./prettier": {
			"types": "./prettier/index.d.ts",
			"default": "./prettier/index.js"
		},
		"./prettier/basic": {
			"types": "./prettier/basic.d.ts",
			"default": "./prettier/basic.js"
		},
		"./prettier/static": {
			"types": "./prettier/static.d.ts",
			"default": "./prettier/static.js"
		},
		"./tsconfig/base": {
			"types": "./tsconfig/base.json",
			"default": "./tsconfig/base.json"
		},
		"./cspell": "./cspell/index.yaml",
		"./version": {
			"types": "./dist/version/index.d.ts",
			"default": "./dist/version/index.js"
		},
		"./config-merge": {
			"types": "./dist/config-merge/index.d.ts",
			"default": "./dist/config-merge/index.js"
		},
		"./self-sync-guard": {
			"types": "./dist/self-sync-guard/index.d.ts",
			"default": "./dist/self-sync-guard/index.js"
		},
		"./managed-marker": {
			"types": "./dist/managed-marker/index.d.ts",
			"default": "./dist/managed-marker/index.js"
		}
	},
	"peerDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@playwright/test": ">=1.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-sonarjs": "^4.2.1",
		"eslint-plugin-unicorn": "^78.0.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	},
