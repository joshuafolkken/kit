		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"lefthook": "^2.1.12",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup": "^4.63.1",
		"rollup-plugin-dts": "^6.5.1",
		"secretlint": "^13.0.5",
