{
	"version": "1.64.0",
	"name": "@joshuafolkken/kit",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"josh": "dist/josh.js"
	},
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain@1.5.1 setup-ci",
		"prepare": "lefthook install",
		"build": "tsx scripts/build-bin.ts && tsx scripts/build-version.ts && tsx scripts/build-config-merge.ts",
		"prepack": "tsx scripts/version/publishable-range-check.ts && tsx scripts/build-bin.ts && tsx scripts/build-version.ts && tsx scripts/build-config-merge.ts",
		"josh": "tsx scripts/josh/josh.ts"
	},
	"files": [
		"dist",
		"scripts",
		"scripts-ai",
		"prompts",
		"templates",
		"eslint",
		"prettier",
		"tsconfig",
		"cspell",
		"lefthook",
		".claude",
		".vscode",
		".github",
		"CLAUDE.md",
		"AGENTS.md",
		"GEMINI.md",
		"CODE_OF_CONDUCT.md",
		"SECURITY.md",
		".cursorrules",
		".coderabbit.yaml",
		".gitattributes",
		".mcp.json",
		".ncurc.json",
		".prettierignore",
		"pnpm-workspace.yaml",
		"tsconfig.sonar.json",
		"playwright.config.ts",
		"!**/*.test.ts",
		"!**/*.spec.ts",
		"!**/*-fixture.ts"
	],
	"imports": {
		"#scripts/*": "./scripts/*.ts"
	},
	"exports": {
		"./eslint/base": "./eslint/base.js",
		"./eslint/vanilla": "./eslint/vanilla.js",
		"./eslint/test-filename": "./eslint/rules/test-filename.js",
		"./prettier": {
			"types": "./prettier/index.d.ts",
			"default": "./prettier/index.js"
		},
		"./tsconfig/base": {
			"types": "./tsconfig/base.json",
			"default": "./tsconfig/base.json"
		},
		"./cspell": "./cspell/index.yaml",
		"./version": {
			"types": "./dist/version/index.d.ts",
			"default": "./dist/version/index.js"
		},
		"./config-merge": {
			"types": "./dist/config-merge/index.d.ts",
			"default": "./dist/config-merge/index.js"
		}
	},
	"peerDependencies": {
		"@playwright/test": ">=1.0.0",
		"eslint": ">=9.18.0",
		"svelte": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
		"@types/node": "^26.2.0",
		"@types/semver": "^7.8.0",
		"cspell": "^10.0.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"lefthook": "^2.1.10",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup": "^4.62.4",
		"rollup-plugin-dts": "^6.5.1",
		"secretlint": "^13.0.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"execa": "^10.0.1",
		"globals": "^17.9.0",
		"js-yaml": "^5.2.3",
		"ora": "^9.4.1",
		"semver": "^7.8.5",
		"strip-json-comments": "^5.0.3",
		"tsx": "^4.23.12",
		"typescript-eslint": "^8.66.0",
		"zod": "^4.4.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
			"onFail": "error"
		}
	}
}
