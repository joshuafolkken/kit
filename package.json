		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-unicorn": "^74.0.0",
		"eslint_d": "^15.0.3",
		"execa": "^10.0.1",
		"globals": "^17.12.0",
		"js-yaml": "^5.4.1",
		"jsonc-parser": "^3.3.1",
		"ora": "^9.4.1",
		"semver": "^7.8.5",
		"strip-json-comments": "^5.0.3",
		"tsx": "^4.23.13",
		"typescript-eslint": "^8.69.0",
		"zod": "^4.5.4"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
