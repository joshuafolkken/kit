		"josh": "tsx scripts/josh/josh.ts"
	},
	"files": [
		"dist",
		"scripts",
		"scripts-ai",
		"prompts",
		"evals",
		"templates",
		"env",
		"eslint",
		"ports",
		"prettier",
		"tsconfig",
		"cspell",
		"lefthook",
		".claude/settings.json",
		".claude/skills",
		".vscode",
		".github",
