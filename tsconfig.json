{
	"extends": "./tsconfig/base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"allowJs": true
	},
	"include": [
		"playwright.config*.ts",
		"playwright-config-fixture.ts",
		"env/**/*.ts",
		"eslint/**/*.ts",
		"ports/**/*.ts",
		"prettier/**/*.d.ts",
		"scripts/**/*.ts",
		"scripts-ai/**/*.ts",
		"templates/**/*.ts"
	]
}
